# Required. Bearer token for the worker/control surface (/tasks, /orchestrator, /langchain, /n8n).
WORKER_TOKEN=change-me

# Webhook secrets. A provider whose secret is unset rejects its webhooks with 503.
GITHUB_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
GENERIC_WEBHOOK_SECRET=

# Optional.
PORT=8000
MAX_BODY_SIZE=5mb

# Worker only.
AGENTSCALE_URL=http://localhost:8000
WORKER_ID=
WORKER_IDLE_MS=1000

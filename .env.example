# Required. Bearer token(s) for the worker/control surface (/tasks, /orchestrator, /langchain,
# /n8n). Comma-separated to issue distinct tokens per worker/caller instead of one shared secret.
WORKER_TOKEN=change-me

# Webhook secrets. A provider whose secret is unset rejects its webhooks with 503.
GITHUB_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
GENERIC_WEBHOOK_SECRET=

# Optional.
PORT=8000
MAX_BODY_SIZE=5mb

# How long a worker may hold a task before it is assumed dead and the task is redelivered.
# Must exceed your slowest agent run — a task still working when its lease expires runs twice.
TASK_VISIBILITY_MS=300000

# Deliveries before a task is given up on, so one poison task cannot cycle forever.
TASK_MAX_ATTEMPTS=3

# Worker only.
AGENTSCALE_URL=http://localhost:8000
WORKER_ID=
WORKER_IDLE_MS=1000

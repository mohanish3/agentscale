# Required. Bearer token(s) for the worker/control surface (/tasks, /orchestrator, /langchain,
# /n8n). Comma-separated to issue distinct tokens per worker/caller instead of one shared secret.
WORKER_TOKEN=change-me

# Webhook secrets. A provider whose secret is unset rejects its webhooks with 503.
GITHUB_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
GENERIC_WEBHOOK_SECRET=

# Optional.
PORT=8000
MAX_BODY_SIZE=5mb

# How long a worker may hold a task before it is assumed dead and the task is redelivered.
# Workers renew every half of this while they work, so it does not have to exceed your slowest
# agent run — it is how quickly a worker that dies is noticed.
TASK_VISIBILITY_MS=300000

# Ceiling on how long renewals can keep one delivery alive. A worker wedged on something that
# never returns renews forever; past this the lease lapses and the task is redelivered. Set it
# above your slowest legitimate agent run and below "obviously stuck".
TASK_MAX_LEASE_MS=3600000

# Deliveries before a task is given up on, so one poison task cannot cycle forever.
TASK_MAX_ATTEMPTS=3

# How long a finished task's record (result, dead-letter entry, webhook dedupe key) is kept
# before it is dropped to bound memory. Keep this longer than your senders' webhook retry
# schedules: once the dedupe key is gone, a redelivery runs the agent again.
TASK_RETENTION_MS=86400000

# Optional allowlist of hostnames that may be registered as LangChain servers. Unset means
# anything except the link-local range (cloud metadata / task-role credentials) is accepted.
# Set it in any deployment where the API holds AWS credentials worth reading.
LANGCHAIN_ALLOWED_HOSTS=

# Worker only.
AGENTSCALE_URL=http://localhost:8000
WORKER_ID=
WORKER_IDLE_MS=1000
